# The runtime target is Linux (an embedded ARM board). Store and check out LF
# everywhere: a CRLF shell script fails on the board with
# "bad interpreter: No such file or directory".
* text=auto eol=lf

# Explicit, so a Windows checkout cannot silently re-introduce CRLF.
*.py    text eol=lf
*.sh    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.env   text eol=lf
*.example text eol=lf
*.service text eol=lf

# Binary — never touch.
*.png   binary
*.jpg   binary
*.wav   binary
*.onnx  binary
*.fmodel binary
*.so    binary
