# Optional L610 4G module -> Huawei Cloud IoTDA.
#
#   cp config/l610.env.example config/l610.env
#
# Only read when the module is actually attached. With no L610 present the
# service logs "AT port not found" and exits; that is expected and non-fatal —
# nothing else in the runtime depends on it.
#
# None of these values may be committed to git.

# Device registration ID issued by the IoTDA console.
L610_DEVICE_ID=your_device_id_here

# Broker endpoint for your IoTDA region, without a scheme or port.
L610_BROKER_HOST=your-region.iotda-device.cn-north-4.myhuaweicloud.com
L610_BROKER_PORT=1883

# Per-device secret. Treat as a password.
L610_DEVICE_SECRET=your_device_secret_here
