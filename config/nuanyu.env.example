# Nuanyu runtime configuration.
#
#   cp config/nuanyu.env.example config/nuanyu.env
#
# then fill in the credentials. config/nuanyu.env is git-ignored — never commit
# a populated copy.
#
# The supervisor sources this file with `set -a`, so everything here is exported
# into the runtime's environment, and these values override the defaults baked
# into the code. Where the two differ, the shipped value below is the one the
# reference board runs, and the code default is noted in the comment.
#
# Types matter: several of these are parsed with int(). A value that does not
# parse (e.g. "0.012" for an integer setting) raises at import and can disable a
# subsystem silently — check the log after changing anything here.

# ── Deployment root ──────────────────────────────────────────────────────────
# Where logs, pid files, runtime state and the model directories live.
# Leave unset to use the repository root (deploy/ and app/ as siblings).
# NUANYU_ROOT=/userdata_fibo

# ── TTS backend ──────────────────────────────────────────────────────────────
# drizzle = Matcha-TTS on the board (offline, default)
# stream  = Doubao cloud TTS (needs the host proxy on 5019)
# surge   = ZipVoice voice cloning on the host PC (needs the tunnel on 5018)
NUANYU_TTS_BACKEND=drizzle

# The opening phrase "nickname," is synthesised first and played after this
# delay, which gives the model a head start on the real first sentence.
TTS_OPENING_DELAY_MS=1000

# Sentence segmentation thresholds, in characters, for streaming synthesis.
# Code defaults are 8 / 12 / 42; the shipped values below are shorter, which
# starts playback sooner at the cost of more synthesis requests.
TTS_STREAM_FIRST_SOFT_CHARS=6
TTS_STREAM_SOFT_CHARS=16
TTS_STREAM_MAX_CHARS=36

# Voice-cloning concurrency. Code default is 3; 1 is correct for the CPU host
# server, which synthesises serially.
SURGE_MAX_CONCURRENT=1

# Board speaker routing. The supervisor forces both of these to 0 at launch:
# the desktop release is board-first, and audio_router falls back to the host
# only after board playback actually fails. Setting them here has no effect.
SURGE_PC_SPEAKER=0
FIBO_TTS_PC_ONLY=0

# Leave FIBO_TTS_HPH_CARD unset: the supervisor resolves the Qualcomm playback
# card by name from /proc/asound/cards on every launch. Card numbers move when
# a USB device is plugged in, so hardcoding one is a known cause of "no sound".
# FIBO_TTS_HPH_CARD=0
FIBO_TTS_HPH_DEVICE=0

# ── Cloud credentials ────────────────────────────────────────────────────────
# Doubao (Volcano) streaming TTS — only needed for the `stream` backend.
DOUBAO_TTS_API_KEY=your_doubao_api_key
DOUBAO_TTS_RESOURCE_ID=your_resource_id
DOUBAO_TTS_VOICE_TYPE=your_voice_type
DOUBAO_TTS_SAMPLE_RATE=24000

# DeepSeek — the conversation model. Reached through the host proxy on 5019.
DEEPSEEK_API_KEY=your_deepseek_api_key

# ── Host endpoints (ADB tunnels) ─────────────────────────────────────────────
# Loopback addresses provided by `adb reverse` from the host PC.
DEEPSEEK_BASE_URL=http://127.0.0.1:5019
DOUBAO_TTS_API_URL=http://127.0.0.1:5019/doubao/tts
ZIPVOICE_SERVER_URL=http://127.0.0.1:5018

# ── ASR ──────────────────────────────────────────────────────────────────────
ASR_ENABLED=true
ASR_BACKEND=whisper_tiny_cpu
# There is no fallback-backend selection: Whisper-Tiny is the only ASR backend
# in this tree. An earlier revision accepted ASR_FALLBACK_BACKEND and read it
# into a constant that nothing consulted; it was removed as dead config.

# auto = board microphone first, host microphone only on failure.
ASR_MIC_SOURCE=auto

# Both of these are INTEGERS, not fractions.
#   SILENCE_THRESHOLD is an RMS level on the int16 scale (code default 180).
#     The shipped value is lower, i.e. more sensitive.
#   SILENCE_TAIL_MS is the trailing silence that ends an utterance.
ASR_SILENCE_THRESHOLD=60
ASR_SILENCE_TAIL_MS=500

# ── Camera ───────────────────────────────────────────────────────────────────
CAMERA_DEVICE=/dev/video2
CAMERA_FALLBACK_URL=http://127.0.0.1:5016/camera.jpg

# ── Voice module UART ────────────────────────────────────────────────────────
# The offline wake-word module. Only one process may open this port.
VOICE_PORT=/dev/ttyHS1
VOICE_BAUD=9600

# ── Runtime behaviour ────────────────────────────────────────────────────────
# Demo mode shortens the idle timers so a stage demo never sits silent:
#   sit reminder 60 s instead of 45 min, low-interaction trigger 75 s
#   instead of 10 min, proactive cooldown 80 s instead of 15 min.
# The *code* default is ON — the reference board ran with it enabled for a
# competition demo. This template ships it OFF, because a real deployment would
# otherwise have the robot interrupt roughly once a minute. Set it back to true
# if you are the one on stage.
NUANYU_DEMO_MODE=false

# ── Audio output ─────────────────────────────────────────────────────────────
# auto = board first, host fallback only after board playback fails.
# board = never fall back.
AUDIO_OUTPUT_MODE=auto

# ── ONNX Runtime threading ───────────────────────────────────────────────────
# Not configurable. The FER backend pins both thread counts to 1 in code
# (app/src/vision/fer_onnx_backend.py), so inference does not contend with the
# DSP models. An earlier revision exported ORT_NUM_INTRAOP_THREADS /
# ORT_NUM_INTEROP_THREADS here; ONNX Runtime does not read either name, and
# neither does any module in this tree, so they were removed as dead config.

# ── Motion controller ────────────────────────────────────────────────────────
# Configured separately — see config/c07a_motion.env.example.

# ── Optional: L610 4G module ─────────────────────────────────────────────────
# Only read when the module is fitted. See config/l610.env.example.
