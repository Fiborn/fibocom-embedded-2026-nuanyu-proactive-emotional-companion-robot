# Nuanyu runtime configuration.
#
#   cp config/nuanyu.env.example config/nuanyu.env
#
# then fill in the credentials. config/nuanyu.env is git-ignored — never commit
# a populated copy.
#
# The start script sources this file with `set -a`, so every value here is
# exported into the runtime's environment. Values set in the shell before
# launch win over nothing: this file wins over the script's defaults.

# ── Deployment root ──────────────────────────────────────────────────────────
# Where logs, pid files, runtime state and the model directories live.
# Leave unset to use the repository root (deploy/ and app/ as siblings).
# NUANYU_ROOT=/userdata_fibo

# ── TTS backend ──────────────────────────────────────────────────────────────
# drizzle = Matcha-TTS on the board (offline, default)
# stream  = Doubao cloud TTS (needs the host proxy on 5019)
# surge   = ZipVoice voice cloning on the host PC (needs the tunnel on 5018)
NUANYU_TTS_BACKEND=drizzle

# Opening phrase "nickname," is synthesised first and played after this delay,
# which gives the model a head start on the real first sentence.
TTS_OPENING_DELAY_MS=1000

# Sentence segmentation thresholds (characters) for streaming synthesis.
TTS_STREAM_FIRST_SOFT_CHARS=6
TTS_STREAM_SOFT_CHARS=12
TTS_STREAM_MAX_CHARS=24

# Voice-cloning concurrency. 1 is correct for the CPU host server.
SURGE_MAX_CONCURRENT=1

# Board speaker routing. Do not turn the PC speaker on in normal operation:
# the product plays all business speech through the board.
SURGE_PC_SPEAKER=0
FIBO_TTS_PC_ONLY=0

# Leave FIBO_TTS_HPH_CARD unset: the start script resolves the Qualcomm
# playback card by name from /proc/asound/cards. Card numbers move whenever a
# USB device is plugged in, so hardcoding one is a known source of "no sound".
# FIBO_TTS_HPH_CARD=2
FIBO_TTS_HPH_DEVICE=0

# ── Cloud credentials ────────────────────────────────────────────────────────
# Doubao (Volcano) streaming TTS — only needed for the `stream` backend.
DOUBAO_TTS_API_KEY=your_doubao_api_key
DOUBAO_TTS_RESOURCE_ID=your_resource_id
DOUBAO_TTS_VOICE_TYPE=your_voice_type
DOUBAO_TTS_SAMPLE_RATE=24000

# DeepSeek — the conversation model. Reached through the host proxy on 5019.
DEEPSEEK_API_KEY=your_deepseek_api_key

# ── Host endpoints (ADB tunnels) ─────────────────────────────────────────────
# These are loopback addresses provided by `adb reverse` from the host PC.
DEEPSEEK_BASE_URL=http://127.0.0.1:5019
DOUBAO_TTS_API_URL=http://127.0.0.1:5019/doubao/tts
ZIPVOICE_SERVER_URL=http://127.0.0.1:5018

# ── ASR ──────────────────────────────────────────────────────────────────────
ASR_ENABLED=true
ASR_BACKEND=whisper_tiny_cpu
ASR_FALLBACK_BACKEND=none

# auto = board microphone first, host microphone only on failure.
ASR_MIC_SOURCE=auto
ASR_SILENCE_THRESHOLD=0.012
ASR_SILENCE_TAIL_MS=600

# ── Camera ───────────────────────────────────────────────────────────────────
CAMERA_DEVICE=/dev/video2
CAMERA_FALLBACK_URL=http://127.0.0.1:5016/camera.jpg

# ── Audio output ─────────────────────────────────────────────────────────────
AUDIO_OUTPUT_MODE=auto

# ── ONNX Runtime threading ───────────────────────────────────────────────────
# Kept low so inference does not contend with the DSP models.
ORT_NUM_INTRAOP_THREADS=2
ORT_NUM_INTEROP_THREADS=1

# ── Optional: L610 4G module ─────────────────────────────────────────────────
# Only read when the module is fitted. See config/l610.env.example.
